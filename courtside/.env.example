# Data provider: "mock" runs the whole app with zero keys and a simulated live game.
SPORTS_PROVIDER=mock
SPORTS_API_KEY=
API_DAILY_LIMIT=1000

# AI utilization insights. Without a key the app falls back to a transparent
# rule-based analysis labelled source="heuristic" — it never invents numbers.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MONTHLY_TOKEN_BUDGET=2000000

# Live polling worker. Off by default so dev servers do not burn API quota.
ENABLE_POLLER=true

# Alert transport. Falls back to console logging when unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

USER_TIMEZONE=America/New_York
PORT=3001
DB_PATH=./courtside.db
